+// Strata (PH402, sm_60): MoE experts read in place.  With `pt` a launch's expert zt reads its matrix at
+// x + tab[zt] + add instead of x + zt*stride_channel_x: x the kernel's const __restrict__ base, tab a device array of
+// byte offsets from it (one per expert of the launch), add 0 for gate/up and the blob's down offset for down.  So the
+// experts need not be copied into one strided buffer first.  Measured on GP100: a by-value table of pointers went to
+// a stack frame (+12% on down) and a device table of POINTERS lost the restrict provenance (generic LD instead of
+// LDG.E.CI, +7% on down); offsets from the restrict base keep the original loads.
+struct mmq_xptrs { const long long * tab; long long add; };
+
 #define MMQ_DP4A_MAX_BATCH_SIZE 64 // Max. batch size to use for dp4a MMQ kernels when FP16 tensor cores are available.
 #define MMQ_ITER_K             256
 #define MMQ_ITER_K_FP4         512
@@ -859,6 +867,19 @@ static constexpr __device__ ggml_cuda_mmq_load_tiles_t ggml_cuda_mmq_get_load_ti
     return ggml_cuda_mmq_get_util_funcs<type, J, fallback>().load_tiles;
 }
 
+// kstop's last half tile: the loader that reads only the tile's first half (the formats of a K % 256 == 128 down
+// matrix in the Strata packs)
+template <ggml_type type, int J, bool fallback>
+static constexpr __device__ ggml_cuda_mmq_load_tiles_t ggml_cuda_mmq_get_load_tiles_half() {
+    if constexpr (type == GGML_TYPE_Q2_0) {
+        return ggml_cuda_mmq_load_tiles_q2_0<type, J, fallback, true>;
+    } else if constexpr (type == GGML_TYPE_IQ4_NL) {
+        return ggml_cuda_mmq_load_tiles_iq4_nl<type, J, fallback, true>;
+    } else {
+        return nullptr;
+    }
+}
